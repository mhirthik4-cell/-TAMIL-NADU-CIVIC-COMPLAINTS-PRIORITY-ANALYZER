def generate_complaints(target_count=45):
    random.seed(42)
    dataset = []
    for i, r in enumerate(REAL_TN_DATA):
        dataset.append(CivicComplaint(
            f"TN-CIVIC-2026-{1001 + i}", r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8],
            "2026-10-15T10:00:00", r[9], r[10], r[11]
        ))
    while len(dataset) < target_count:
        base = random.choice(REAL_TN_DATA)
        dataset.append(CivicComplaint(
            f"TN-CIVIC-2026-{1001 + len(dataset)}", base[0], base[1], base[2], f"{base[3]} (Sector B)",
            base[4] + random.uniform(-0.006, 0.006), base[5] + random.uniform(-0.006, 0.006),
            base[6], f"[Repeat Grievance] {base[7]}", "GCC/CCMC Portal",
            "2026-10-16T12:00:00", max(1, int(random.gauss(base[9], 14))), random.randint(1, 5), round(random.uniform(0.5, 9.0), 1)
        ))
    return dataset

# 5. Multi-Criteria Prioritization Engine
def prioritize_complaints(complaint_list):
    density = defaultdict(int)
    for c in complaint_list:
        density[f"{c.city}_{c.zone}"] += 1

    for c in complaint_list:
        txt = (c.raw_text + " " + c.landmark).lower()
        
        # Hazard Score (Max: 35)
        base_h = SEVERITY_BASE.get(c.category, 15.0)
        kw_pts = sum(pts for kw, pts in [('open manhole', 15), ('live wire', 16), ('drinking water', 14), ('kudineer', 12), ('uyir abathu', 15), ('accident', 12)] if kw in txt)
        c.hazard_score = min(base_h + (kw_pts * 0.25), 35.0)

        # Vulnerability Score (Max: 20)
        vuln = 0.0
        if any(h in txt for h in ['hospital', 'stanley', 'rajaji', 'cmch', 'rgggh', 'ambulance']): vuln += 8.0
        elif any(s in txt for s in ['school', 'children', 'college', 'hostel']): vuln += 6.0
        elif any(b in txt for b in ['bus stand', 'railway', 'market', 'lake link']): vuln += 5.0
        if "Madipakkam" in c.zone or "Sellur" in c.zone: vuln += 5.0
        c.vulnerability_score = min(vuln, 20.0)

        # Citizen Impact (Max: 20)
        up_score = min(math.log2(c.upvotes + 1) * 3.5, 12.0)
        c.citizen_impact_score = min(up_score + (c.repeat_reports * 2.5), 20.0)

        # SLA Aging Penalty (Max: 15)
        overdue = max(0.0, c.days_open - SLA_LIMITS_DAYS.get(c.category, 2.0))
        c.sla_penalty = min(overdue * 3.0, 15.0)

        # Cluster Density Boost (Max: 10)
        c.density_boost = min(density[f"{c.city}_{c.zone}"] * 1.5, 10.0)

        # Total Priority (0 - 100)
        total = c.hazard_score + c.vulnerability_score + c.citizen_impact_score + c.sla_penalty + c.density_boost
        c.total_priority_score = round(min(total, 100.0), 1)

        # Classification
        if c.total_priority_score >= 75: c.priority_level = "P1"
        elif c.total_priority_score >= 55: c.priority_level = "P2"
        elif c.total_priority_score >= 38: c.priority_level = "P3"
        else: c.priority_level = "P4"

        # Action Order for Municipal Squad
        if "Manhole" in c.category:
            c.action_recommendation = "EMERGENCY: Immediate safety barricade & replace heavy iron slab within 6 hrs."
        elif "Electric Wire" in c.category:
            c.action_recommendation = "CRITICAL: Alert TANGEDCO power isolation team & clear dangling wire."
        elif "Sewage" in c.category and ("drinking" in txt or "kudineer" in txt):
            c.action_recommendation = "HEALTH EMERGENCY: Deploy MetroWater jetting machine; halt contaminated supply."
        elif "Sewage" in c.category:
            c.action_recommendation = "Deploy super-sucker drainage tanker & clear trunk line sewer choke."
        elif "Potholes" in c.category:
            c.action_recommendation = "Deploy quick-curing asphalt cold-mix squad on arterial bus corridor."
        elif "Water Pipeline" in c.category:
            c.action_recommendation = "Water Board pipe gang dispatch: isolate feeder line valve and clamp fracture."
        elif "Waterlogging" in c.category:
            c.action_recommendation = "Deploy heavy dewatering diesel pumps and desilt drainage canal culvert."
        else:
            c.action_recommendation = "Municipal sanitary/electrical van dispatch for routine resolution."

    return sorted(complaint_list, key=lambda x: x.total_priority_score, reverse=True)

# 6. Zonal Aggregation (Identify Areas Needing Attention First)
def aggregate_areas(complaints):
    zones = defaultdict(list)
    for c in complaints:
        zones[(c.city, c.zone)].append(c)

    zone_stats = []
    for (city, zone), items in zones.items():
        p1 = sum(1 for x in items if x.priority_level == "P1")
        p2 = sum(1 for x in items if x.priority_level == "P2")
        sla_b = sum(1 for x in items if x.sla_penalty > 0)
        avg_score = sum(x.total_priority_score for x in items) / len(items)
        urgency_idx = round(min((p1 * 20.0) + (p2 * 10.0) + (sla_b * 5.0) + (avg_score * 0.4), 100.0), 1)
        
        cats = defaultdict(int)
        for x in items: cats[x.category] += 1
        top_cat = max(cats.items(), key=lambda k: k[1])[0]

        zone_stats.append({
            "City": city,
            "Zone / Area": zone,
            "Urgency Index (0-100)": urgency_idx,
            "P1 Critical": p1,
            "P2 High": p2,
            "SLA Breached": sla_b,
            "Dominant Issue": top_cat
        })

    zone_stats.sort(key=lambda z: z["Urgency Index (0-100)"], reverse=True)
    return zone_stats

# 7. Interactive Folium Map
def generate_map(complaints):
    colors = {"P1": "#d32f2f", "P2": "#f57c00", "P3": "#fbc02d", "P4": "#388e3c"}
    tn_map = folium.Map(location=[11.1271, 78.6569], zoom_start=7, tiles="OpenStreetMap")
    cluster = MarkerCluster(name="Tamil Nadu Civic Hotspots").add_to(tn_map)

    for c in complaints:
        color = colors.get(c.priority_level, "blue")
        popup_html = f"""
        <div style="font-family: Arial; width: 260px; font-size: 12px;">
            <div style="background-color: {color}; color: white; padding: 5px; font-weight: bold; border-radius: 3px;">
                [{c.priority_level}] Score: {c.total_priority_score} | {c.complaint_id}
            </div>
            <p style="margin: 4px 0;"><b>{c.city}</b> ({c.zone})<br>
            <b>Problem:</b> {c.category}<br>
            <b>Landmark:</b> {c.landmark}<br>
            <b>Days Open:</b> {c.days_open}d | <b>Upvotes:</b> {c.upvotes}</p>
            <div style="background-color: #e8f5e9; padding: 5px; border-left: 3px solid #2e7d32; font-size: 11px;">
                <b>Dispatch:</b> {c.action_recommendation}
            </div>
        </div>
        """
        folium.CircleMarker(
            location=[c.latitude, c.longitude],
            radius=8 if c.priority_level == "P1" else 5,
            popup=folium.Popup(popup_html, max_width=300),
            tooltip=f"[{c.priority_level}] {c.city} - {c.category}",
            color=color, fill=True, fill_color=color, fill_opacity=0.85
        ).add_to(cluster)
    return tn_map

